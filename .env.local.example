NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# InstaWP — used to provision fresh WordPress installs for migrations
# Get your API key at https://app.instawp.io/settings/api-tokens
INSTAWP_API_KEY=your_instawp_api_key_here
# Optional: a pre-configured InstaWP site template ID
INSTAWP_TEMPLATE_ID=
